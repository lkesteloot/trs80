{
  "compilerOptions": {
    "target": "ES2019",
    // Type definitions for ES2022 built-ins like Array.prototype.at(), which Node 24
    // and current browsers have. Code is still compiled for ES2019.
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    // Include all @types packages, as TypeScript did by default before 6.0.
    "types": ["*"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    // Otherwise have build errors with eslint imported by other packages:
    "skipLibCheck": true,
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitReturns": true,
    "exactOptionalPropertyTypes": true,
    "incremental": true,
    // Keep incremental state with the output, so "clean" (rm -rf dist) forces a full rebuild.
    "tsBuildInfoFile": "${configDir}/dist/tsconfig.tsbuildinfo"
  }
}
