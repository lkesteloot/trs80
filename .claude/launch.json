{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "my-trs-80",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "start",
        "-w",
        "packages/my-trs-80",
        "--",
        "--port",
        "5191",
        "--strictPort"
      ],
      "port": 5191
    },
    {
      "name": "trs80-ide",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "start",
        "-w",
        "packages/trs80-ide",
        "--",
        "--port",
        "5192",
        "--strictPort"
      ],
      "port": 5192
    },
    {
      "name": "trs80-disk-webapp",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "start",
        "-w",
        "packages/trs80-disk-webapp",
        "--",
        "--port",
        "5193",
        "--strictPort"
      ],
      "port": 5193
    },
    {
      "name": "site",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "5194",
        "--directory",
        "deploy/my-trs-80/site"
      ],
      "port": 5194
    }
  ]
}