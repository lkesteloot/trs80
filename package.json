{
  "name": "root",
  "private": true,
  "repository": "https://github.com/lkesteloot/trs80.git",
  "scripts": {
    "build": "npm run typecheck && npm run build --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present",
    "test": "vitest run",
    "pretest": "npm run generateRoms -w packages/trs80-emulator --silent",
    "pretypecheck": "npm run updateBuildInfo --workspaces --if-present --silent && npm run generateRoms -w packages/trs80-emulator --silent",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "workspaces": [
    "packages/fp-215",
    "packages/retrostore-api",
    "packages/z80-base",
    "packages/z80-logger",
    "packages/z80-inst",
    "packages/z80-disasm",
    "packages/z80-asm",
    "packages/z80-emulator",
    "packages/z80-test",
    "packages/trs80-base",
    "packages/trs80-asm",
    "packages/trs80-emulator",
    "packages/trs80-cassette",
    "packages/trs80-cassette-player",
    "packages/trs80-emulator-web",
    "packages/trs80-cassette-webapp",
    "packages/trs80-ide",
    "packages/trs80-tool",
    "packages/my-trs-80"
  ]
}
