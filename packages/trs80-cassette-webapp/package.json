    "vite": "^8.3.0"
  },
  "dependencies": {
    "jss": "^10.0.3",
    "jss-preset-default": "^10.0.3",
    "split.js": "^1.5.11",
    "strongly-typed-events": "^3.0.0",
    "teamten-ts-utils": "^1.0.3",
    "trs80-base": "*",
    "trs80-cassette": "*",
    "trs80-cassette-player": "*",
    "trs80-emulator": "*",
