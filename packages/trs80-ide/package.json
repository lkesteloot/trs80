{
  "name": "trs80-ide",
  "private": true,
  "description": "Web app with interactive TRS-80 assembly language IDE.",
  "repository": "https://github.com/lkesteloot/trs80.git",
  "author": "Lawrence Kesteloot <lk@teamten.com> (https://www.teamten.com/lawrence/)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "vite --open",
    "updateBuildInfo": "../../printBuildInfo > src/build.ts",
    "build": "npm run updateBuildInfo && vite build --base=./",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.4",
    "@codemirror/commands": "^6.8.0",
    "@codemirror/language": "^6.10.8",
    "@codemirror/lint": "^6.8.4",
    "@codemirror/search": "^6.5.8",
    "@codemirror/state": "^6.5.1",
    "@codemirror/view": "^6.36.2",
    "@lezer/highlight": "^1.1.1",
    "browser-fs-access": "^0.35.0",
    "cm6-theme-solarized-dark": "^0.2.0",
    "retrostore-api": "*",
    "strongly-typed-events": "^3.0.0",
    "trs80-asm": "*",
    "trs80-base": "*",
    "trs80-cassette": "*",
    "trs80-emulator": "*",
    "trs80-emulator-web": "*",
    "z80-asm": "*",
    "z80-base": "*",
    "z80-disasm": "*",
    "z80-inst": "*"
  },
  "devDependencies": {
    "@types/gtag.js": "^0.0.20",
    "vite": "^8.3.0"
  }
}
